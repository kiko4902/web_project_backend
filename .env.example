# Supabase project URL (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: used together with the caller's access token, so RLS applies
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only, bypasses RLS. Used for the rate-limit counters and
# the demo:create script. Never expose it to the frontend.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string. Only the db:* scripts use it, not the API.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

PORT=3000
# Comma-separated browser origins allowed to call the API. * matches one
# hostname segment, e.g. https://my-app-*.vercel.app for preview deployments.
CORS_ORIGINS=http://localhost:5173

# Optional: account behind the "Try demo" button (create it with npm run demo:create)
DEMO_EMAIL=
DEMO_PASSWORD=

# Optional: account used by npm run smoke
SMOKE_EMAIL=
SMOKE_PASSWORD=
