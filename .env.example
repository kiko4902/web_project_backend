# Supabase project URL (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: used with the caller's access token so RLS applies
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only, bypasses RLS. Never expose to the frontend
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string, used only by migration and seed scripts
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

PORT=3000
